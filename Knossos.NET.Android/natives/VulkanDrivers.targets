<Project>
  <PropertyGroup>
    <AdrenotoolsDirectory Condition="'$(AdrenotoolsDirectory)' == ''">$(MSBuildThisFileDirectory)3rdparty/libadrenotools</AdrenotoolsDirectory>
    <_VulkanDriverSource Condition="('$(RuntimeIdentifier)' == 'android-arm64'
                                   Or ('$(RuntimeIdentifier)' == '' And $(RuntimeIdentifiers.Contains('android-arm64'))))
                                   And Exists('$(AdrenotoolsDirectory)/CMakeLists.txt')">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AdrenotoolsDirectory)'))</_VulkanDriverSource>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repackage when the optional checkout is added, removed, or changed. -->
    <_PropertyCacheItems Include="VulkanDriverSource=$(_VulkanDriverSource)" />
  </ItemGroup>

  <Target Name="BuildVulkanDriverLoader" BeforeTargets="_CheckProjectItems"
          DependsOnTargets="_ResolveMonoAndroidSdks"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(_VulkanDriverSource)' != ''">
    <PropertyGroup>
      <_VulkanNativeBuild>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'vulkan-drivers'))</_VulkanNativeBuild>
      <_VulkanExecutableSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_VulkanExecutableSuffix>
      <_VulkanTools>$(_AndroidSdkDirectory)cmake/3.22.1/bin</_VulkanTools>
      <VulkanAndroidNdkDirectory Condition="'$(VulkanAndroidNdkDirectory)' == '' And '$(AndroidNdkDirectory)' != ''">$(AndroidNdkDirectory)</VulkanAndroidNdkDirectory>
      <VulkanAndroidNdkDirectory Condition="'$(VulkanAndroidNdkDirectory)' == ''">$(_AndroidSdkDirectory)ndk/28.2.13676358</VulkanAndroidNdkDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_VulkanDriverSource)/lib/linkernsbypass/CMakeLists.txt')"
           Text="Initialize the libadrenotools submodules (git submodule update --init --recursive)." />
    <Error Condition="!Exists('$(_VulkanTools)/cmake$(_VulkanExecutableSuffix)') Or !Exists('$(VulkanAndroidNdkDirectory)/build/cmake/android.toolchain.cmake')"
           Text="Building the Vulkan driver loader requires Android SDK CMake 3.22.1 and Android NDK 28.2.13676358 (or a VulkanAndroidNdkDirectory override)." />
    <Exec Command="&quot;$(_VulkanTools)/cmake$(_VulkanExecutableSuffix)&quot; -S &quot;$(MSBuildThisFileDirectory).&quot; -B &quot;$(_VulkanNativeBuild)&quot; -G Ninja &quot;-DCMAKE_MAKE_PROGRAM=$(_VulkanTools)/ninja$(_VulkanExecutableSuffix)&quot; &quot;-DCMAKE_TOOLCHAIN_FILE=$(VulkanAndroidNdkDirectory)/build/cmake/android.toolchain.cmake&quot; -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-28 -DANDROID_STL=c++_static -DCMAKE_BUILD_TYPE=Release &quot;-DADRENOTOOLS_DIR=$(_VulkanDriverSource)&quot;" />
    <Exec Command="&quot;$(_VulkanTools)/cmake$(_VulkanExecutableSuffix)&quot; --build &quot;$(_VulkanNativeBuild)&quot; --target fsovulkan" />
    <ItemGroup>
      <AndroidNativeLibrary Include="$(_VulkanNativeBuild)/libfsovulkan.so;$(_VulkanNativeBuild)/libmain_hook.so;$(_VulkanNativeBuild)/libhook_impl.so" Abi="arm64-v8a" />
    </ItemGroup>
  </Target>
</Project>
