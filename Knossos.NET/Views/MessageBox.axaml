<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Knossos.NET.Views.MessageBox"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Border x:Name="CardBorder"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="520" Margin="12"
            CornerRadius="12" BorderThickness="1"
            BorderBrush="{StaticResource BackgroundColorTertiary}"
            Background="{StaticResource BackgroundColorPrimary}"
            BoxShadow="0 8 24 0 #60000000">
        <Grid RowDefinitions="Auto,*,Auto" Margin="16">
            <TextBlock x:Name="TitleText" Classes="h1" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap"/>
                    <StackPanel x:Name="LibraryPicker" IsVisible="False" Spacing="4">
                        <TextBlock Text="Library" FontWeight="SemiBold"/>
                        <ComboBox x:Name="LibrarySelector" HorizontalAlignment="Stretch" AutomationProperties.Name="Destination library">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <WrapPanel x:Name="ButtonsHostPanel" Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </Grid>
    </Border>
</UserControl>
